#!/bin/bash

# check variables, like all scripts herein do
WRS_SCRIPT_NAME=$(basename $0)

if [ -z "$WRS_BASE_DIR" ]; then
    echo "$0: Plesae set WRS_BASE_DIR" >& 2
    exit 1
fi
. ${WRS_BASE_DIR}/scripts/wrs_functions

wrs_check_vars WRS_OUTPUT_DIR WRS_DOWNLOAD_DIR CROSS_COMPILE

wrs_echo "--- Create firmware with alternative config files"
# This appends to the WRS firmware alternative (e.g., configuration) files.

alt_versions=$(ls "$WRS_BASE_DIR"/../configs/alt_configs)

for alt_ver in $alt_versions; do
    wrs_echo "--- Alternative config $alt_ver: Create firmware"

    wrs_echo "--- Alternative config $alt_ver: Append dot-config"
    # Apply changes from dot-config_append into dot-config
    cd "$WRS_BASE_DIR"/..
    # Add dot-config_append at the end of .config
    if [ -e configs/alt_configs/"$alt_ver"/dot-config_append ]; then
	echo "Found dot-config_append, append it to existing dot-config."
	cat configs/alt_configs/"$alt_ver"/dot-config_append >> .config || wrs_die "Append dot-config_append"
	# Solve dependencies in .config
	make olddefconfig 2>&1 || wrs_die "make olddefconfig"
	# Resulting .config will be copied later
    fi

    wrs_echo "--- Alternative config $alt_ver: Update firmware"
    TMPFS=$(mktemp -d /tmp/wrs_alt_version.XXXXXX)
    chmod a+rx $TMPFS
    cd "$TMPFS" || wrs_die "cd $TMPFS"
    # Copy files for firmware
    cp "$WRS_OUTPUT_DIR/images/wrs-initramfs.gz" . || wrs_die "tar wrs-initramfs.gz"
    cp "$WRS_OUTPUT_DIR/images/at91bootstrap.bin" . || wrs_die "at91bootstrap.bin"
    cp "$WRS_OUTPUT_DIR/images/barebox.bin" . || wrs_die "barebox.bin"
    cp "$WRS_OUTPUT_DIR/images/zImage" . || wrs_die "cp zImage"

    # Append files from configs/alt_configs/$alt_ver to wrs-usr.tar.gz
    gunzip -c "$WRS_OUTPUT_DIR/images/wrs-usr.tar.gz" > wrs-usr.tar || wrs_die "gunzip wrs-usr.tar.gz"

    mkdir -p "$TMPFS"/wr/etc || wrs_die "mkdir wr/etc"
    if [ -e "$WRS_BASE_DIR"/../configs/alt_configs/"$alt_ver"/tx_phase_cal.conf ]; then
	echo "Found tx_phase_cal.conf, copy it."
	cp "$WRS_BASE_DIR"/../configs/alt_configs/"$alt_ver"/tx_phase_cal.conf wr/etc || wrs_die "cp tx_phase_cal.conf"
    fi

    if [ -e "$WRS_BASE_DIR"/../configs/alt_configs/"$alt_ver"/dot-config_append ]; then
	echo "Found dot-config_append, copy new dot-config."
	# Copy dot-config only if dot-config_append is present
	cp "$WRS_BASE_DIR"/../.config wr/etc/dot-config || wrs_die "cp dot-config"
    fi

    echo "Add files to wrs-usr.tar.gz"
    tar -rvf wrs-usr.tar wr || wrs_die "tar"
    gzip wrs-usr.tar || wrs_die "gzip"

    #### Finally, create the overall tarball for installation

    ## Create a package for distribution. The package contains:
    #  - at91bootstrap.bin
    #  - barebox.bin
    #  - zImage
    #  - wrs-iniramfs.gz
    #  - wrs-usr.tar.gz
    # Actually, the pack is already built by "wrs_build_wraprootfs", so check
    packlist="wrs_firmware_version.txt at91bootstrap.bin barebox.bin zImage wrs-initramfs.gz wrs-usr.tar.gz"
    checksum_file="checksums.md5"

    wrs_echo "--- Alternative config $alt_ver: Calculating checksums";
    # Check if the current git repo correspond to a tag
    version=$(cd $WRS_BASE_DIR; git describe --always --dirty)
    # Add a file with version info
    echo "$version" > "wrs_firmware_version.txt"

    rm -f "$checksum_file"
    for file in $packlist; do
	md5sum "$file" >> "$checksum_file"
    done

    # Put $checksum_file first into the archive. In case the archive is damaged,
    # the beginning of the archive has the biggest chance to be untouched
    packlist="$checksum_file $packlist"
    # If prefix 'wr-switch-sw-' is not set in tagname, we force it to
    # 'wr-switch-sw-unof-'
    name=$(echo $version | sed  '/^wr-switch-sw-/! s/.*/wr-switch-sw-unof-\0/')
    # add date and suffix
    # Note: it might happen that the date changes between builds for different
    # alternative versions
    name="${name}-$(date +%Y%m%d)_hw_${alt_ver//./_}_binaries.tar"

    wrs_echo "--- Alternative config $alt_ver: Packing into $name";
    (cd "$TMPFS" && tar cf wrs-firmware.tar  $packlist) || wrs_die "tar firmware in tmp"
    (cd "$TMPFS" && cp wrs-firmware.tar "$WRS_OUTPUT_DIR"/$name) || wrs_die "cp firmware to build directory"

    # remove temporaries or keep them
    if [ -z "$CONFIG_KEEP_ROOTFS" ]; then
	rm -rf $TMPFS
    else
	wrs_echo "Image FS is in $TMPFS/"
	wrs_echo "Generated by $TMPSCRIPT"
    fi
done
