+ 
+-	return agent_v_chassis(vp, var_len, LOCAL_CHASSIS(scfg));
++	if ((a = agent_v_chassis(vp, var_len, LOCAL_CHASSIS(scfg))) != NULL)
++		return a;
++	TRYNEXT(agent_h_local_chassis);
+ }
